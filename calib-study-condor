#!/usr/bin/env bash
# Submit an HTCondor DAG that runs calib-study over the input list in parallel:
# one map job per input .root file, then one merge job that adds the partial
# histograms and writes the reports and plots.

set -euo pipefail

# Change the requested resources here!
map_request_cpus=1
map_request_memory=4G
map_request_disk=4G
merge_request_cpus=1
merge_request_memory=8G
merge_request_disk=8G
# Used only by --single-job, which does the map and merge work in one job.
single_request_cpus=2
single_request_memory=16G
single_request_disk=16G

usage() {
  cat <<'USAGE'
Usage: ./calib-study-condor <input-address-txt> <production-tag> [tree-name] [--Vcb] [--single-job]

Submit a Condor DAG that splits the study across the input files:

  map    one job per .root file in <input-address-txt>, each running
         ./calib-study <one-file-list> <production-tag> [tree-name] [--Vcb] \
             --partial outputs/<production-tag>/condor/partials/partial-NNN.root
  merge  one job, run after every map job succeeds, running
         ./calib-study <input-address-txt> <production-tag> [tree-name] [--Vcb] \
             --merge outputs/<production-tag>/condor/partials

With --single-job, submit one plain Condor job that runs the whole study
sequentially instead:
  ./calib-study <input-address-txt> <production-tag> [tree-name] [--Vcb]

The study results are written to outputs/<production-tag>/. The generated
worker scripts, submit descriptions, per-file input lists, partial histograms
and Condor logs are written under outputs/<production-tag>/condor/.
USAGE
}

if [[ $# -eq 1 && ( "$1" == "-h" || "$1" == "--help" ) ]]; then
  usage
  exit 0
fi

if [[ $# -lt 2 ]]; then
  usage >&2
  exit 2
fi

input_address_txt=$1
production_tag=$2
shift 2
tree_name=
tree_name_set=false
run_vcb_studies=false
single_job=false
for value in "$@"; do
  if [[ "$value" == "--Vcb" ]]; then
    if [[ "$run_vcb_studies" == true ]]; then
      echo "calib-study-condor: --Vcb may be specified only once." >&2
      exit 2
    fi
    run_vcb_studies=true
  elif [[ "$value" == "--single-job" ]]; then
    if [[ "$single_job" == true ]]; then
      echo "calib-study-condor: --single-job may be specified only once." >&2
      exit 2
    fi
    single_job=true
  elif [[ "$value" == --* ]]; then
    echo "calib-study-condor: unknown option: $value" >&2
    exit 2
  elif [[ "$tree_name_set" == true ]]; then
    echo "calib-study-condor: only one optional tree-name may be specified." >&2
    exit 2
  else
    tree_name=$value
    tree_name_set=true
  fi
done

case "$production_tag" in
  ''|.|..|*/*|*\\*)
    echo "calib-study-condor: production-tag must be one safe path component (no '/' or '\\')." >&2
    exit 2
    ;;
esac

if [[ "$input_address_txt" == *$'\n'* || "$production_tag" == *$'\n'* || "$tree_name" == *$'\n'* ]]; then
  echo "calib-study-condor: arguments cannot contain a newline." >&2
  exit 2
fi

repo_root=$(cd -P -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
study_executable="$repo_root/calib-study"
cmssw_source_file="$repo_root/cmsenv-source.txt"

if [[ ! -x "$study_executable" ]]; then
  echo "calib-study-condor: missing executable: $study_executable" >&2
  echo "Rebuild it with 'make' after initializing cmsenv." >&2
  exit 1
fi
if [[ ! -f "$input_address_txt" ]]; then
  echo "calib-study-condor: input address file not found: $input_address_txt" >&2
  exit 1
fi
if [[ ! -r "$cmssw_source_file" ]]; then
  echo "calib-study-condor: missing CMSSW source file: $cmssw_source_file" >&2
  exit 1
fi
if ! command -v condor_submit >/dev/null 2>&1; then
  echo "calib-study-condor: condor_submit is not available in PATH." >&2
  exit 1
fi
if [[ "$single_job" == false ]] && ! command -v condor_submit_dag >/dev/null 2>&1; then
  echo "calib-study-condor: condor_submit_dag is not available in PATH." >&2
  echo "Re-run with --single-job to submit one sequential job instead." >&2
  exit 1
fi

input_directory=$(cd -P -- "$(dirname -- "$input_address_txt")" && pwd)
input_address_txt="$input_directory/$(basename -- "$input_address_txt")"

IFS= read -r cmssw_src < "$cmssw_source_file" || true
if [[ -z "${cmssw_src:-}" || ! -d "$cmssw_src" ]]; then
  echo "calib-study-condor: cmsenv-source.txt must contain an existing CMSSW src directory." >&2
  exit 1
fi
cmssw_src=$(cd -P -- "$cmssw_src" && pwd)

output_directory="$repo_root/outputs/$production_tag"
condor_directory="$output_directory/condor"

# Emit the preamble that puts a worker inside the CMSSW release and this repo.
# Values are rendered as shell words so that paths containing spaces or shell
# metacharacters stay literal.
write_worker_preamble() {
  printf '%s\n' '#!/usr/bin/env bash'
  printf '%s\n' 'set -euo pipefail'
  printf 'repo_root=%q\n' "$repo_root"
  printf 'cmssw_src=%q\n' "$cmssw_src"
  printf 'condor_directory=%q\n' "$condor_directory"
  printf 'input_address_txt=%q\n' "$input_address_txt"
  printf 'production_tag=%q\n' "$production_tag"
  if [[ "$tree_name_set" == true ]]; then
    printf 'tree_name=%q\n' "$tree_name"
  fi
  printf 'run_vcb_studies=%q\n' "$run_vcb_studies"
  printf '%s\n' 'source /cvmfs/cms.cern.ch/cmsset_default.sh'
  printf '%s\n' 'cd "$cmssw_src"'
  printf '%s\n' 'eval "$(scram runtime -sh)"'
  printf '%s\n' 'cd "$repo_root"'
}

# Emit the shared tail that appends the optional tree name and --Vcb flag.
write_worker_common_arguments() {
  printf '%s\n' 'if [[ -n "${tree_name:-}" ]]; then command+=("$tree_name"); fi'
  printf '%s\n' 'if [[ "$run_vcb_studies" == true ]]; then command+=(--Vcb); fi'
}

# $1 submit file, $2 executable, $3 arguments, $4 log stem,
# $5 cpus, $6 memory, $7 disk
write_submit_file() {
  {
    printf '%s\n' 'universe = vanilla'
    # HTCondor treats spaces in submit-file values as literal characters, so
    # these path-valued settings must not be shell- or double-quote escaped.
    printf 'executable = %s\n' "$2"
    if [[ -n "$3" ]]; then
      printf 'arguments = %s\n' "$3"
    fi
    printf 'initialdir = %s\n' "$condor_directory"
    printf '%s\n' 'getenv = true'
    printf '%s\n' 'should_transfer_files = NO'
    printf '%s\n' 'notification = never'
    printf 'log = %s\n' "$condor_directory/logs/$4.log"
    printf 'output = %s\n' "$condor_directory/logs/$4.out"
    printf 'error = %s\n' "$condor_directory/logs/$4.err"
    printf 'request_cpus = %s\n' "$5"
    printf 'request_memory = %s\n' "$6"
    printf 'request_disk = %s\n' "$7"
    printf '%s\n' 'queue'
  } > "$1"
}

if [[ "$single_job" == true ]]; then
  mkdir -p -- "$condor_directory/logs"
  runner="$condor_directory/run-calib-study.sh"
  submit_file="$condor_directory/calib-study.sub"
  {
    write_worker_preamble
    printf '%s\n' 'command=("$repo_root/calib-study" "$input_address_txt" "$production_tag")'
    write_worker_common_arguments
    printf '%s\n' 'exec "${command[@]}"'
  } > "$runner"
  chmod 755 "$runner"

  write_submit_file "$submit_file" "$runner" "" "calib-study" \
    "$single_request_cpus" "$single_request_memory" "$single_request_disk"

  echo "Submitting one Condor job for production tag '$production_tag'."
  condor_submit "$submit_file"
  echo "Results and Condor logs: $output_directory"
  exit 0
fi

# Split the input list the same way calib-study reads it: skip blank lines and
# comments, and require every remaining line to name a .root file.
mapfile -t root_files < <(
  sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -- "$input_address_txt" |
    grep -v -e '^$' -e '^#'
)
if [[ ${#root_files[@]} -eq 0 ]]; then
  echo "calib-study-condor: no .root files found in $input_address_txt" >&2
  exit 1
fi
for root_file in "${root_files[@]}"; do
  if [[ "$root_file" != *.root ]]; then
    echo "calib-study-condor: input line is not a .root file: $root_file" >&2
    exit 1
  fi
done

# A stale partial from an earlier submission of the same tag would be summed
# into the merge, so start from an empty directory.
rm -rf -- "$condor_directory/inputs" "$condor_directory/partials"
mkdir -p -- "$condor_directory/inputs" "$condor_directory/partials" "$condor_directory/logs"

map_runner="$condor_directory/run-calib-study-map.sh"
merge_runner="$condor_directory/run-calib-study-merge.sh"
map_submit_file="$condor_directory/calib-study-map.sub"
merge_submit_file="$condor_directory/calib-study-merge.sub"
dag_file="$condor_directory/calib-study.dag"

{
  write_worker_preamble
  printf '%s\n' 'index=$1'
  printf '%s\n' 'command=("$repo_root/calib-study" "$condor_directory/inputs/input-$index.txt" "$production_tag")'
  write_worker_common_arguments
  printf '%s\n' 'command+=(--partial "$condor_directory/partials/partial-$index.root")'
  printf '%s\n' 'exec "${command[@]}"'
} > "$map_runner"
chmod 755 "$map_runner"

{
  write_worker_preamble
  printf '%s\n' 'command=("$repo_root/calib-study" "$input_address_txt" "$production_tag")'
  write_worker_common_arguments
  printf '%s\n' 'command+=(--merge "$condor_directory/partials")'
  printf '%s\n' 'exec "${command[@]}"'
} > "$merge_runner"
chmod 755 "$merge_runner"

write_submit_file "$map_submit_file" "$map_runner" '$(index)' 'map-$(index)' \
  "$map_request_cpus" "$map_request_memory" "$map_request_disk"
write_submit_file "$merge_submit_file" "$merge_runner" "" "merge" \
  "$merge_request_cpus" "$merge_request_memory" "$merge_request_disk"

{
  map_nodes=()
  for position in "${!root_files[@]}"; do
    index=$(printf '%03d' "$position")
    printf '%s\n' "${root_files[position]}" > "$condor_directory/inputs/input-$index.txt"
    printf 'JOB map_%s %s\n' "$index" "$map_submit_file"
    printf 'VARS map_%s index="%s"\n' "$index" "$index"
    map_nodes+=("map_$index")
  done
  printf 'JOB merge %s\n' "$merge_submit_file"
  printf 'PARENT %s CHILD merge\n' "${map_nodes[*]}"
} > "$dag_file"

echo "Submitting Condor DAG for production tag '$production_tag':" \
     "${#root_files[@]} map jobs and 1 merge job."
condor_submit_dag -force "$dag_file"
echo "Results and Condor logs: $output_directory"
